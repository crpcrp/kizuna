{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // `scripts/` is plain ESM run by bare `node` (no build step), so its tests
    // import `.mjs` and rely on inference rather than declarations.
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@scripts/*": ["./scripts/*"]
    },
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test", "electron.vite.config.ts", "vitest.config.ts"]
}
