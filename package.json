{
  "name": "kizuna",
  "version": "0.4.0",
  "description": "Windows and Linux desktop video player for Japanese language learning.",
  "author": "Adam Kocsis",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/crpcrp/kizuna",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "kizuna.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "start:linux": "electron-vite preview -- --ozone-platform=x11",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "resources": "node scripts/fetch-resources.mjs",
    "jlpt-data:update": "node scripts/update-jlpt-vocabulary.mjs",
    "jlpt-kanji-data:update": "node scripts/update-jlpt-kanji.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "postinstall": "install-electron && electron-rebuild -f -w better-sqlite3",
    "dist": "npm run notices && electron-vite build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "smoke:linux": "node scripts/smoke-linux-package.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "js-yaml": "^5.2.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true,
    "electron-winstaller": false,
    "koffi": false
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "koffi": "^3.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
