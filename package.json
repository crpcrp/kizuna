{
  "name": "kizuna",
  "version": "0.0.1",
  "description": "Windows-first desktop video player for Japanese language learning.",
  "author": "Adam Kocsis",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "resources": "node scripts/fetch-resources.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "postinstall": "install-electron && electron-rebuild -f -w better-sqlite3",
    "dist": "npm run notices && electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true,
    "electron-winstaller": false
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "fflate": "^0.8.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
